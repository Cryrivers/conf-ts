{
  "name": "@conf-ts/expression",
  "version": "0.0.27",
  "description": "JavaScript expression evaluator",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "Zhongliang Wang",
    "email": "hello@zhongliang.wang",
    "url": "https://zhongliang.wang"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cryrivers/conf-ts"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/require.d.cts",
        "default": "./dist/require.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.mts",
        "default": "./dist/zod.mjs"
      },
      "require": {
        "types": "./dist/zod.d.cts",
        "default": "./dist/zod.cjs"
      }
    }
  },
  "scripts": {
    "test": "vitest run --typecheck",
    "bench": "pnpm build && node benchmark/compile.mjs",
    "bench:memory": "pnpm build && node benchmark/memory.mjs",
    "format": "prettier --write .",
    "lint:fix": "oxlint --fix",
    "type-check": "tsc --noEmit",
    "build": "tsdown --minify",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@conf-ts/expr-core": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@vitest/coverage-v8": "5.0.5",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
